{
  "name": "ggm",
  "displayName": "GGM",
  "description": "GGM language support: compiler diagnostics, hover, go to definition, completion, rename",
  "version": "0.1.1",
  "publisher": "mcd0luo",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:ggm"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ggm",
        "aliases": [
          "GGM"
        ],
        "extensions": [
          ".ggm"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": {
      "title": "GGM",
      "properties": {
        "ggm.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ggmls binary. Empty means: ggmls.exe in the workspace root, then the copy bundled with this extension, then PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Mcd0LUO/GoGoMcfunction.git"
  }
}
