// luo:math —— 原库 309 行 / 17 文件的 GGM 移植
namespace luo:math

comptime {
    // 只生成真正被引用的常量
    for n in [1, 2, 4, 100, 1000, 2147483647, -1] { emit("#math." + str(n), "math", n) }
}

extern arg1: int = @s.arg1
extern arg2: int = @s.arg2
extern arg3: int = @s.arg3
extern return: int = @s.return
extern temp1: int = @s.temp1
extern SEED: int = seed.math

const LCG_A = 1103515245
const LCG_C = 1234
const LCG_M = 67108864

#[wrapping]
fn lcg_step(s: int) -> int {
    (LCG_A * s + LCG_C) % LCG_M
}

fn lcg_next() -> int {
    let x = lcg_step(SEED)
    SEED = SEED + LCG_C
    x
}

fn rand(lo: int, hi: int) -> int {
    let span = hi - lo + 1
    let x = lcg_next()
    lo + rem_euclid(x, span)
}

fn chance(scale: int, p: int) -> bool {
    rand(1, scale) <= p
}

fn is_happen_fix100(p: int) -> bool {
    chance(100, p)
}

fn is_happen_fix1000(p: int) -> bool {
    chance(1000, p)
}

// 收敛判据不能用「与上一次估计之差」：它在不动点两侧振荡，
// sqrt(99) 会得到 10。起始值避开 (x+1)/2 的 int32 回绕。
fn sqrt(n: int) -> int {
    let x = n
    let y = x / 2 + x % 2
    while y < x cap 64 {
        x = y
        y = (x + n / x) / 2
    }
    x
}

fn sort_asc() {
    let rank = 0
    while any<@a[tag=math.sort]> cap 64 {
        let lo = reduce<min>(@a[tag=math.sort], math)
        @a[tag=math.sort] temp1 = lo
        rank = rank + 1
    }
}

on load {
    SEED = 12345
}