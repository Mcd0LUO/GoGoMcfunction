// luo:math —— 原库 309 行 / 17 文件的 CMCF 移植
namespace luo:math

comptime {
    // 只生成真正被引用的常量
    for n in [1, 2, 4, 100, 1000, 2147483647, -1] { emit("#math." + str(n), "math", n) }
}

extern var arg1: int @ "arg1"
extern var arg2: int @ "arg2"
extern var arg3: int @ "arg3"
extern var return: int @ "return"
extern var temp1: int @ "temp1"
extern global SEED: int @ "math" @holder "seed"

const LCG_A = 1103515245
const LCG_C = 1234
const LCG_M = 67108864

#[wrapping]
fn lcg_step(s: int) -> int {
    (LCG_A * s + LCG_C) % LCG_M
}

fn lcg_next() -> int {
    let x = lcg_step(SEED)
    SEED = SEED + LCG_C
    x
}

fn rand(lo: int, hi: int) -> int {
    let span = hi - lo + 1
    let x = lcg_next()
    lo + rem_euclid(x, span)
}

fn chance(scale: int, p: int) -> bool {
    rand(1, scale) <= p
}

fn is_happen_fix100(p: int) -> bool {
    chance(100, p)
}

fn is_happen_fix1000(p: int) -> bool {
    chance(1000, p)
}

fn sqrt(n: int) -> int {
    if n < 4 { return 1 }
    let x = n / 4
    let prev = 0
    while abs(x - prev) >= 1 #[budget(32)] {
        prev = x
        x = (x + n / x) / 2
    }
    x
}

fn sort_asc() {
    let rank = 0
    while any<@a[tag=math.sort]> #[budget(64)] {
        let lo = reduce<min>(@a[tag=math.sort], math)
        @a[tag=math.sort] temp1 = lo
        rank = rank + 1
    }
}

on load {
    SEED = 12345
}
