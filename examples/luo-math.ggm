// luo:math —— 原来 309 行手写 mcfunction 的 GGM 版本
namespace luo:math

comptime {
    for n in -1..3 { emit("#math." + str(n), "math", n) }
}

extern arg1: int = @s.arg1
extern return: int = @s.return
extern SEED: int = seed.math

const LCG_A = 1103515245
const LCG_C = 1234
const LCG_M = 67108864

#[wrapping]
fn lcg_step(s: int) -> int {
    (LCG_A * s + LCG_C) % LCG_M
}

// 整数平方根，向下取整。
//
// 收敛判据不能用「与上一次估计之差」——那个形状在不动点两侧振荡，
// 99 会让结果落在 10（而 10² = 100 > 99），返回哪个取决于预算耗尽时的奇偶。
// 牛顿法从 n 以上单调下降，判据改成「y 不再比 x 小」就到不动点了。
//
// 起始值写 x / 2 + x % 2 而不是 (x + 1) / 2：两者都是上取整，
// 但后者在 x = 2147483647 时 x+1 先回绕成负数。
fn sqrt(n: int) -> int {
    let x = n
    let y = x / 2 + x % 2
    while y < x, budget 64 {
        x = y
        y = (x + n / x) / 2
    }
    x
}

fn is_happen_fix1000(p: int) -> bool {
    let r = (SEED * LCG_A + LCG_C) % LCG_M
    let span = 1000
    r <= p
}

on load {
    SEED = 12345
}